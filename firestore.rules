rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary rule for the current login design:
    // the app queries /users by email before any FirebaseAuth session exists.
    // This is insecure because password is stored in Firestore and readable.
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
